# Copy this file to backend/.env and fill in local values.
# Never commit real passwords or tokens.

DB_URL=jdbc:postgresql://localhost:5432/vayomitra_database
DB_USER=postgres
DB_PASSWORD=change-me

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Authentication
TOKEN_EXPIRY_HOURS=24
BCRYPT_COST=10

# File uploads (kept outside the React public folder)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
MAX_JSON_BYTES=1048576

# Matching weights (must sum to 1.00)
MATCH_SKILL_WEIGHT=0.40
MATCH_DISTANCE_WEIGHT=0.25
MATCH_AVAILABILITY_WEIGHT=0.20
MATCH_QUALIFICATION_WEIGHT=0.15
DEFAULT_SERVICE_RADIUS_KM=15

# Local demo accounts (created only when the users table is empty)
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo@12345
